{
    "name": "lihi/shorturl-php82",
    "description": "lihi WP Plugin test dependencies for PHP 8.2",
    "license": "GPL-2.0-or-later",
    "type": "wordpress-plugin",
    "require-dev": {
        "phpunit/phpunit": "^9",
        "wp-phpunit/wp-phpunit": "7.1.1",
        "yoast/phpunit-polyfills": "^2",
        "brain/monkey": "^2",
        "johnpbloch/wordpress": "7.1.1",
        "php-stubs/wordpress-stubs": "^7.0"
    },
    "config": {
        "vendor-dir": "vendor",
        "platform": {
            "php": "8.2.30"
        },
        "allow-plugins": {
            "johnpbloch/wordpress-core-installer": true
        }
    },
    "extra": {
        "wordpress-install-dir": "wordpress"
    },
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "johnpbloch/wordpress-core",
                "version": "7.1.1",
                "type": "wordpress-core",
                "license": "GPL-2.0-or-later",
                "dist": {
                    "url": "https://wordpress.org/wordpress-7.1.1.zip",
                    "type": "zip"
                },
                "require": {
                    "php": ">=7.4",
                    "ext-json": "*"
                },
                "provide": {
                    "wordpress/core-implementation": "7.1.1"
                }
            }
        }
    ]
}
